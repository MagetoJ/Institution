<odoo>
    <record id="action_school_fee_invoices" model="ir.actions.act_window">
        <field name="name">Fee Invoices</field>
        <field name="res_model">account.move</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('student_id', '!=', False)]</field>
        <field name="context">{'default_move_type': 'out_invoice'}</field>
        <field name="view_ids" eval="[(5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('account.view_out_invoice_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('account.view_move_form')})]"/>
    </record>

    <menuitem id="menu_school_fees" name="Fees"
              parent="school_base.menu_school_root" sequence="20"
              groups="school_base.group_school_accountant,school_base.group_school_admin"/>
    <menuitem id="menu_school_fee_generate" name="Generate Invoices"
              parent="menu_school_fees" action="action_school_fee_invoice_wizard" sequence="10"/>
    <menuitem id="menu_school_fee_invoices" name="Invoices"
              parent="menu_school_fees" action="action_school_fee_invoices" sequence="20"/>

    <menuitem id="menu_school_terms" name="Terms"
              parent="school_base.menu_school_config" action="action_school_term" sequence="15"/>
    <menuitem id="menu_school_fee_structures" name="Fee Structures"
              parent="school_base.menu_school_config" action="action_school_fee_structure" sequence="40"/>
</odoo>
