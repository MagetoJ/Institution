<odoo>
    <record id="view_school_term_list" model="ir.ui.view">
        <field name="name">school.term.list</field>
        <field name="model">school.term</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="academic_year_id"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>
    <record id="action_school_term" model="ir.actions.act_window">
        <field name="name">Terms</field>
        <field name="res_model">school.term</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
