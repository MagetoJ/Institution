<odoo>
    <record id="view_school_fee_invoice_wizard_form" model="ir.ui.view">
        <field name="name">school.fee.invoice.wizard.form</field>
        <field name="model">school.fee.invoice.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="term_id"/>
                    <field name="class_ids" widget="many2many_tags"/>
                    <field name="invoice_date"/>
                    <field name="due_date"/>
                </group>
                <footer>
                    <button name="action_generate" type="object"
                            string="Generate Invoices" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_school_fee_invoice_wizard" model="ir.actions.act_window">
        <field name="name">Generate Fee Invoices</field>
        <field name="res_model">school.fee.invoice.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
