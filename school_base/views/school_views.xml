<odoo>
    <!-- Student -->
    <record id="view_school_student_list" model="ir.ui.view">
        <field name="name">school.student.list</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <list>
                <field name="admission_no"/>
                <field name="name"/>
                <field name="class_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_school_student_form" model="ir.ui.view">
        <field name="name">school.student.form</field>
        <field name="model">school.student</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="admission_no"/>
                            <field name="birth_date"/>
                            <field name="gender"/>
                        </group>
                        <group>
                            <field name="class_id"/>
                            <field name="guardian_ids" widget="many2many_tags"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_school_student" model="ir.actions.act_window">
        <field name="name">Students</field>
        <field name="res_model">school.student</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Academic year -->
    <record id="view_school_year_list" model="ir.ui.view">
        <field name="name">school.academic.year.list</field>
        <field name="model">school.academic.year</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="date_start"/>
                <field name="date_end"/>
            </list>
        </field>
    </record>
    <record id="action_school_year" model="ir.actions.act_window">
        <field name="name">Academic Years</field>
        <field name="res_model">school.academic.year</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Grade -->
    <record id="view_school_grade_list" model="ir.ui.view">
        <field name="name">school.grade.list</field>
        <field name="model">school.grade</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
            </list>
        </field>
    </record>
    <record id="action_school_grade" model="ir.actions.act_window">
        <field name="name">Grades</field>
        <field name="res_model">school.grade</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Class -->
    <record id="view_school_class_list" model="ir.ui.view">
        <field name="name">school.class.list</field>
        <field name="model">school.class</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="grade_id"/>
                <field name="academic_year_id"/>
                <field name="teacher_id"/>
            </list>
        </field>
    </record>
    <record id="action_school_class" model="ir.actions.act_window">
        <field name="name">Classes</field>
        <field name="res_model">school.class</field>
        <field name="view_mode">list</field>
    </record>

    <!-- Menus -->
    <menuitem id="menu_school_root" name="School" sequence="10"
              groups="group_school_teacher,group_school_accountant,group_school_admin"/>
    <menuitem id="menu_school_students" name="Students"
              parent="menu_school_root" action="action_school_student" sequence="10"/>
    <menuitem id="menu_school_config" name="Configuration"
              parent="menu_school_root" sequence="90"/>
    <menuitem id="menu_school_years" name="Academic Years"
              parent="menu_school_config" action="action_school_year" sequence="10"/>
    <menuitem id="menu_school_grades" name="Grades"
              parent="menu_school_config" action="action_school_grade" sequence="20"/>
    <menuitem id="menu_school_classes" name="Classes"
              parent="menu_school_config" action="action_school_class" sequence="30"/>
</odoo>
